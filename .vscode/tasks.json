{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "pipeline: run TUI (menu principal)",
			"type": "shell",
			"command": "uv --system-certs run python main.py",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "pipeline: smart sync / auto-backfill (mais recente ate ontem)",
			"type": "shell",
			"command": "uv --system-certs run python scripts/run_araucaria_full.py --auto-backfill",
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "pipeline: extract full period (01/Aug to yesterday)",
			"type": "shell",
			"command": "uv --system-certs run python scripts/run_araucaria_full.py --start-date 2026-08-01",
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "pipeline: extract single day (yesterday)",
			"type": "shell",
			"command": "uv --system-certs run python scripts/run_araucaria_full.py --days-back 1",
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "governance: model registry table",
			"type": "shell",
			"command": "uv --system-certs run python -c \"from src.models.registry import ModelRegistry; ModelRegistry().render_registry_table()\"",
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "governance: continuity calendar",
			"type": "shell",
			"command": "uv --system-certs run python -c \"from src.visualization.continuity import render_continuity_calendar; render_continuity_calendar()\"",
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "ml: train voltage classifier",
			"type": "shell",
			"command": "uv --system-certs run python scripts/train_voltage_classifier.py",
			"options": {
				"env": {
					"PYTHONPATH": "${workspaceFolder}"
				}
			},
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "pipeline: run total",
			"type": "shell",
			"command": "uv --system-certs run python scripts/run_total_pipeline.py --days-back 1",
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "pipeline: smoke test (offline e2e)",
			"type": "shell",
			"command": "uv --system-certs run python scripts/run_total_pipeline.py --smoke-test",
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "pytest: run all tests",
			"type": "shell",
			"command": "uv --system-certs run pytest tests/ -v",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "pytest: run with coverage",
			"type": "shell",
			"command": "uv --system-certs run pytest tests/ -v --tb=short",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "pytest: run voltage tests",
			"type": "shell",
			"command": "uv --system-certs run pytest tests/test_voltage_classifier.py -v",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "pytest: run continuity tests",
			"type": "shell",
			"command": "uv --system-certs run pytest tests/test_continuity.py -v",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "pytest: run e2e pipeline test",
			"type": "shell",
			"command": "uv --system-certs run pytest tests/test_full_pipeline_e2e.py -v",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "weather: integration test",
			"type": "shell",
			"command": "uv run python tests/test_weather_integration.py",
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "python: run integrity check",
			"type": "shell",
			"command": "uv --system-certs run python -m integrity_check --base-dir output",
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "check last date",
			"type": "shell",
			"command": "scripts\\check_last_date.cmd",
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "git: status",
			"type": "shell",
			"command": "git status",
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "git: branch",
			"type": "shell",
			"command": "git branch",
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "git: create branch",
			"type": "shell",
			"command": "git checkout -b ${input:branchName}",
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "git: checkout branch",
			"type": "shell",
			"command": "git checkout ${input:branchName}",
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "git: checkout main",
			"type": "shell",
			"command": "git checkout main",
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "git: add all",
			"type": "shell",
			"command": "git add .",
			"group": "none",
			"presentation": {
				"reveal": "silent",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "git: commit",
			"type": "shell",
			"command": "git commit -m \"${input:commitMessage}\"",
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "git: push",
			"type": "shell",
			"command": "git push -u origin ${input:branchName}",
			"group": "none",
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"id": "branchName",
			"type": "promptString",
			"description": "Branch name",
			"default": "main"
		},
		{
			"id": "commitMessage",
			"type": "promptString",
			"description": "Commit message"
		}
	]
}